{
  "uid": "knittda-overview",
  "title": "knittda — Overview",
  "schemaVersion": 38,
  "version": 4,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "env",
        "type": "query",
        "label": "env",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up, env)",
        "query": {
          "query": "label_values(up, env)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "sort": 1,
        "hide": 0,
        "regex": ""
      },
      {
        "name": "slot",
        "type": "query",
        "label": "slot",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up, slot)",
        "query": {
          "query": "label_values(up, slot)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "sort": 1,
        "hide": 0,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Targets Up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"knittda\", slot=~\"$slot\", env=~\"$env\"})"
        }
      ]
    },
    {
      "id": 2,
      "title": "요청률 (req/s) by uri",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{slot=~\"$slot\", env=~\"$env\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP p95 지연 (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{slot=~\"$slot\", env=~\"$env\"}[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Heap 사용률",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", slot=~\"$slot\", env=~\"$env\"}) / sum(jvm_memory_max_bytes{area=\"heap\", slot=~\"$slot\", env=~\"$env\"})"
        }
      ]
    },
    {
      "id": 5,
      "title": "외부 의존 실패율 by target",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target) (rate(external_call_seconds_count{result=\"error\", slot=~\"$slot\", env=~\"$env\"}[5m])) / sum by (target) (rate(external_call_seconds_count{slot=~\"$slot\", env=~\"$env\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "DB 쿼리률 (q/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(jdbc_query_seconds_count{slot=~\"$slot\", env=~\"$env\"}[1m])"
        }
      ]
    },
    {
      "id": 7,
      "title": "외부 의존 p95 지연 by target (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, target) (rate(external_call_seconds_bucket{slot=~\"$slot\", env=~\"$env\"}[5m])))"
        }
      ]
    }
  ]
}